{
  "name": "isystem-os",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.11"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "nanoid@3": "3.3.18",
    "dompurify": "3.4.13",
    "postcss": "8.5.23",
    "sharp": "$sharp"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "setup": "node --import tsx scripts/setup.mjs",
    "doctor": "node --import tsx scripts/doctor.mjs",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "build:turbopack": "next build --turbopack",
    "start": "HOSTNAME=0.0.0.0 node scripts/start-standalone.mjs",
    "start:standalone": "node scripts/start-standalone.mjs",
    "worker:seo-internal-links": "tsx --require ./scripts/register-server-only.cjs scripts/seo-internal-link-worker.ts --daemon",
    "worker:source-intelligence": "tsx --require ./scripts/register-server-only.cjs scripts/source-intelligence-worker.ts --daemon",
    "worker:outreach-discovery": "tsx --require ./scripts/register-server-only.cjs scripts/outreach-discovery-worker.ts --daemon",
    "worker:outreach-dispatch": "tsx --require ./scripts/register-server-only.cjs scripts/outreach-dispatch-worker.ts --daemon",
    "worker:creative-render": "tsx --require ./scripts/register-server-only.cjs scripts/creative-render-worker.ts --daemon",
    "worker:workflow": "tsx --require ./scripts/register-server-only.cjs scripts/workflow-worker.ts --daemon",
    "worker:content-translation": "tsx --require ./scripts/register-server-only.cjs scripts/content-translation-worker.ts --daemon",
    "cron:source-intelligence": "tsx --require ./scripts/register-server-only.cjs scripts/source-intelligence-cron-trigger.ts",
    "cron:newsletter-dispatch": "tsx --require ./scripts/register-server-only.cjs scripts/newsletter-dispatch-cron-trigger.ts",
    "cron:creative-render": "tsx --require ./scripts/register-server-only.cjs scripts/creative-render-cron-trigger.ts",
    "cron:voice-memo-processing": "tsx --require ./scripts/register-server-only.cjs scripts/voice-memo-processing-cron-trigger.ts",
    "cron:outreach-dispatch": "tsx --require ./scripts/register-server-only.cjs scripts/outreach-dispatch-cron-trigger.ts",
    "cron:gsc-sync": "tsx --require ./scripts/register-server-only.cjs scripts/gsc-sync-cron-trigger.ts",
    "cron:indexing": "tsx --require ./scripts/register-server-only.cjs scripts/seo-indexing-cron-trigger.ts",
    "cron:booking-payment-followups": "tsx --require ./scripts/register-server-only.cjs scripts/booking-payment-followups-cron-trigger.ts",
    "cron:content-freshness": "tsx --require ./scripts/register-server-only.cjs scripts/content-freshness-cron-trigger.ts",
    "cron:market-monitor": "tsx --require ./scripts/register-server-only.cjs scripts/market-monitor-cron-trigger.ts",
    "audit:source-registry-health": "tsx scripts/audit-source-registry-health.ts",
    "smoke:podcast-media": "node scripts/smoke-vertex-ai-models.mjs --podcast-media-only",
    "test:ffmpeg": "node --import tsx --test src/shared/lib/media/ffmpeg.test.ts src/shared/lib/ai/tts-providers/ffmpeg-tts-concat.test.ts scripts/prepare-standalone.test.mjs",
    "test:bootstrap": "node --import tsx --test scripts/bootstrap.test.ts",
    "test:branding": "node --import tsx --test scripts/reusable-branding-contract.test.ts src/features/seo/lib/google-search-console/site-association.test.ts",
    "test:client-config": "node --import tsx --test src/shared/lib/client-config/schema.test.ts src/shared/lib/client-config/load.test.ts src/shared/lib/client-config/provisioning.test.ts src/shared/lib/client-config/runtime.test.ts src/shared/lib/site-url.test.ts src/features/tools/shared/availability.test.ts",
    "seed:client": "tsx scripts/seed-client.ts",
    "verify": "npm run snapshot:verify && npm run imports:verify && npm run docs:public-check && npm run test:bootstrap && npm run test:branding && npm run test:client-config && npm run test:secret-scan && npm run secret-scan && npm run test:ai-contracts && npm run test:ffmpeg && npm run test:public-quality && npm run test:dashboard-navigation && npm run test:release-contracts && npm run typecheck && npm run lint && npm run build",
    "test:ai-contracts": "node --import tsx --test src/shared/lib/ai/errors.test.ts src/shared/lib/ai/provider-timeout.test.ts src/shared/lib/ai/model-generation-upgrade.test.ts src/shared/lib/ai/transcribe-metadata.test.ts src/shared/lib/ai/image-model-migration.test.ts src/shared/lib/ai/vertex-image-request.test.ts src/shared/lib/ai/prompt-safety.test.ts src/shared/lib/ai/output-safety.test.ts src/shared/lib/ai/tts-providers/google-tts-contract.test.ts src/shared/lib/ai/tts-providers/google-tts-retry.test.ts src/shared/lib/ai/tts-providers/text-chunker.test.ts src/shared/lib/ai/music-providers/lyria-contract.test.ts src/app/api/generate-podcast-episode/podcast-script-contract.test.ts src/app/api/generate-podcast-episode/podcast-storage-contract.test.ts src/app/api/generate-assets/request-contract.test.ts src/app/api/generate-node/cta-url.test.ts src/features/content-engine/generation/draft-request-contract.test.ts src/features/content-engine/generation/derived-formats.test.ts src/features/content-engine/lib/diagram-intents.test.ts src/features/content-engine/lib/normalize-markdown.test.ts src/features/legibility-hub/semantic-search-scope.test.ts src/features/opportunity-engine/detectors/market-monitor-detector.test.ts src/features/blog/translation-job-policy.test.ts scripts/workspace-ai-execution-contract.test.ts scripts/content-ai-workspace-contract.test.ts scripts/legibility-tenant-isolation-contract.test.ts scripts/draft-pipeline-contract.test.ts scripts/intelligence-bridge-contract.test.ts scripts/content-translation-job-contract.test.ts scripts/ai-system-evaluation-contract.test.ts",
    "test:source-intelligence": "node --import tsx --test src/features/source-intelligence/*.test.ts",
    "test:email-lifecycle": "node --import tsx --test src/features/communications/*.test.ts",
    "test:booking-management": "node --import tsx --test src/features/booking/lib/customer-management-*.test.ts src/features/booking/lib/booking-email-recovery-policy.test.ts src/features/communications/customer-booking-management-integration.test.ts",
    "test:public-quality": "node --import tsx --test src/features/blog/ui/public-evidence.test.tsx src/features/booking/lib/privacy.test.ts src/features/content-engine/lib/blog-editorial-policy.test.ts src/features/content-engine/lib/blog-editorial-validation.test.ts src/features/content-engine/lib/editorial-repair.test.ts src/features/content-engine/ui/blog-visual-block.test.tsx src/features/public-site/public-copy-integrity.test.ts src/features/public-site/public-page-seo.test.ts src/features/public-site/sitemap-policy.test.ts src/features/source-intelligence/public.test.ts",
    "test:outreach": "node --import tsx --test src/features/outreach/*.test.ts",
    "test:external-publishing": "node --import tsx --test src/features/external-publishing/*.test.ts",
    "test:business-spine": "node --import tsx --test src/features/business-spine/*.test.ts",
    "test:productivity": "node --import tsx --test src/features/productivity/**/*.test.ts src/shared/lib/ai/transcribe-metadata.test.ts",
    "test:dashboard-navigation": "node --import tsx --test src/features/admin/lib/dashboard-navigation.test.ts",
    "test:secret-scan": "node --test scripts/secret-scan.test.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "lint": "eslint",
    "test:e2e:prod": "npm run build && playwright test tests/smoke tests/a11y",
    "test:a11y": "playwright test tests/a11y",
    "docs:public-check": "node scripts/check-public-docs.mjs",
    "imports:verify": "node scripts/verify-public-script-imports.mjs",
    "license:inventory": "node scripts/generate-third-party-inventory.mjs",
    "public:release-gate": "bash scripts/public-release-gate.sh",
    "snapshot:manifest": "node scripts/verify-public-snapshot-manifest.mjs --write",
    "snapshot:verify": "node scripts/verify-public-snapshot-manifest.mjs --verify",
    "typecheck": "tsc --noEmit",
    "test:release-contracts": "node --import tsx --test src/features/contact/public-submission.test.ts \"src/app/media/public/[...path]/cache-policy.test.ts\" src/features/seo/lib/google-search-console/sync-outcome.test.ts src/features/booking/lib/booking-email-delivery-outcome.test.ts && npm run test:booking-management && npm run test:outreach"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.30",
    "@ai-sdk/google-vertex": "^4.0.140",
    "@ai-sdk/openai": "^3.0.30",
    "@ai-sdk/react": "^3.0.99",
    "@gsap/react": "^2.1.2",
    "@puckeditor/core": "^0.22.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-blockquote": "^3.20.0",
    "@tiptap/extension-bold": "^3.20.0",
    "@tiptap/extension-code": "^3.20.0",
    "@tiptap/extension-code-block": "^3.20.0",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-document": "^3.20.0",
    "@tiptap/extension-font-family": "^3.20.0",
    "@tiptap/extension-hard-break": "^3.20.0",
    "@tiptap/extension-heading": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.0",
    "@tiptap/extension-horizontal-rule": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-italic": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-list": "^3.20.0",
    "@tiptap/extension-paragraph": "^3.20.0",
    "@tiptap/extension-strike": "^3.20.0",
    "@tiptap/extension-text": "^3.20.0",
    "@tiptap/extension-text-align": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-typography": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/html": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@types/marked": "^5.0.2",
    "@types/turndown": "^5.0.6",
    "ai": "^6.0.97",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.34.3",
    "google-auth-library": "^10.9.1",
    "gsap": "^3.14.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.575.0",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "next": "15.5.21",
    "openai-edge": "^1.2.2",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tsx": "^4.22.4",
    "turndown": "^7.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "shadcn": "3.8.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "description": "Self-hostable, configurable business operating system for service teams.",
  "license": "Apache-2.0",
  "homepage": "https://isystem.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AfifiNL/isystem-os.git"
  },
  "bugs": {
    "url": "https://github.com/AfifiNL/isystem-os/issues"
  }
}
