# iSystem OS public beta configuration template
# `npm run setup` copies this to .env.local only when missing.
# Replace REQ values. Never commit .env.local.

# REQ: application and Supabase
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# REC: the reverse proxy must overwrite this custom header with one client IP.
# Do not use a client-controlled forwarding header unless the proxy normalizes it.
TRUSTED_CLIENT_IP_HEADER=x-trusted-client-ip

# REQ for staged booking-management links: use an independently generated,
# server-only secret of at least 32 UTF-8 bytes. The current key signs new links.
BOOKING_MANAGEMENT_SECRET=replace-me-with-at-least-32-random-bytes
# OPT rotation key: temporarily set this to the prior current key. It verifies
# existing links only; remove it after every link signed with that key expires.
BOOKING_MANAGEMENT_SECRET_PREVIOUS=

# REC: Docker Compose host limits. Tune after observing representative workloads.
ISYSTEM_PORT=3000
ISYSTEM_CPU_LIMIT=2.0
ISYSTEM_MEMORY_LIMIT=2g
ISYSTEM_PIDS_LIMIT=512
# Writable in-memory media scratch space. Keep at least 1 GiB for FFmpeg jobs.
ISYSTEM_SCRATCH_SIZE=1g

# OPT: AI provider. Leave blank to keep AI-assisted features disabled.
AI_PROVIDER=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# OPT: outbound email. Use a verified sender before enabling email workflows.
NEWSLETTER_FROM_EMAIL=noreply@example.invalid
NEWSLETTER_REPLY_TO_EMAIL=reply@example.invalid
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NEWSLETTER_DISPATCH_SECRET=
LEGAL_FROM_EMAIL=noreply@example.invalid
LEGAL_REPLY_TO_EMAIL=reply@example.invalid

# OPT: payments. Keep checkout disabled until webhook verification is tested.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_VERIFY_MODE=postback
PAYPAL_BRAND_NAME=iSystem OS
PAYPAL_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# OPT: system media tools. The Docker image configures these automatically.
FFMPEG_PATH=
FFPROBE_PATH=
